# Server Port
PORT=5000
NODE_ENV=production

# Frontend Client URL
CLIENT_URL=https://unfold-navy-nine.vercel.app

# UPI ID for Unfold Payments
UPI_ID=9336991973@ptaxis

# MongoDB Connection String (Atlas or Local)
# Required for persistent records and payment confirmation
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/unfold?retryWrites=true&w=majority

# Razorpay API Credentials (from Razorpay Dashboard -> Account & Settings -> API Keys)
# Required for real ₹19 order creation and signature verification
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

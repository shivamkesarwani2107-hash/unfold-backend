# Server Port
PORT=5000
NODE_ENV=production

# Frontend Client URL (e.g. your deployed Vercel URL)
CLIENT_URL=https://your-unfold-app.vercel.app

# UPI ID for Unfold Payments
UPI_ID=9336991973@ptaxis

# MongoDB Connection String (Atlas or Local)
# Leave blank to run with seamless in-memory fallback
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/unfold?retryWrites=true&w=majority

# Razorpay API Credentials (from Razorpay Dashboard -> Settings -> API Keys)
# Keep blank or fill when activated
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
